# cp .env.example .env   |  NOT real secrets
NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://YOUR-DOMAIN.invalid
COOKIE_SECURE=true
# One controlled reverse proxy; it must overwrite the real client IP header. Direct Node access: 0.
TRUST_PROXY=1
DB_HOST=db
DB_PORT=3306
DB_USER=forum
DB_NAME=trust_forum
DB_PASSWORD=REPLACE_WITH_RANDOM_32_CHARS
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_32_CHARS
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_THIRD_RANDOM_32_CHARS
# Production requires real Cloudflare Turnstile keys. Development can leave empty.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
# Only used for manual CLI: docker compose run --rm -e INIT_ADMIN_* ... app node scripts/bootstrap-admin.js
INIT_ADMIN_USERNAME=
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=

# V2.4 public donation receiving addresses: HMAC key must be unique, secret and NEVER stored in DB.
# Generate once: openssl rand -hex 32. Keep persistent across deployments/restarts.
# Production refuses to start without this key. Losing it invalidates existing donation settings.
DONATION_CONFIG_HMAC_KEY=
# V2.4 private self-hosted LibreTranslate endpoint; no user-controlled URLs or API keys.
TRANSLATE_INTERNAL_URL=http://translate:5000
# Private IPv4 addresses are accepted for a separate translation server.
# For a controlled internal DNS name, add that exact hostname here; no wildcards.
TRANSLATE_ALLOWED_HOSTS=
TRANSLATE_LOAD_ONLY=en,zh,zt,ja,ko,es,fr,de,pb
TRANSLATE_MODEL_REVISION=1
TRANSLATE_CONCURRENCY=2
TRANSLATE_QUEUE_SIZE=32
TRANSLATE_QUEUE_WAIT_MS=15000
TRANSLATE_TIMEOUT_MS=30000
TRANSLATE_MEMORY=16g
TRANSLATE_CPUS=8.0
APP_MEMORY=2g
APP_CPUS=2.0

# V2.7 password recovery: use a dedicated SMTP sender. Do NOT log reset links.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
